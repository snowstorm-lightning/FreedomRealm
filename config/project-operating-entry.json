  "assignmentRules": {
    "splitWhen": [
      "涉及 3 个以上边界上下文",
      "同时需要产品、接口、实现、测试和文档",
      "预计超过 30 到 60 分钟且需要 checkpoint",
      "需要并行探索不同方案",
      "影响 ToolContract、ApprovalGate、ExecutionReportCard、dataClassification 或预算策略"
    ],
    "defaultRules": [
      "一个任务只能有一个最终 owner",
      "单 agent 适合处理 writeSet 单一且可一次验证的任务",
      "子 agent 可以探索、实现或评审，但不能独立并入主线事实",
      "高风险动作必须回到 ApprovalGate"
    ]
  },
  "leaseTemplate": {
    "requiredFields": [
      "leaseId",
      "workItemId",
      "shardId",
      "parentShardId",
      "ownerAgentRole",
      "objective",
      "nonGoals",
      "readSet",
      "writeSet",
      "allowedToolContracts",
      "forbiddenActions",
      "dataClassification",
      "riskLevel",
      "modelRoute",
      "expectedOutputSchema",
      "checkpointPolicy",
      "verificationCommands",
      "deliverables",
      "rollbackPlan",
      "mergeGateRequirements",
      "stopConditions"
    ]
  },
  "conflictRules": {
    "defaultWriteSetPolicy": "non-overlapping",
    "rules": [
      "并行 WorkShard 的 writeSet 默认不得重叠",
      "subagent 不能自行扩大 writeSet；需要扩大时必须回到主 agent 或 human owner",
      "必须重叠时需要指定统一 owner",
      "后启动的 shard 必须等待、缩小范围或转为只读探索",
      "同一路径不得同时执行 update/delete/write；同一接口或 schema 不得由多个 shard 并行定义",
      "跨 ApprovalGate、ToolContract、DataClassification、ExecutionReportCard 或 FederationMessage 的变更必须进入 MergeGate",
      "ChangePacket 必须列出文件、接口影响、测试结果、风险、人工复核点和回滚方式",
      "MergeGate 必须检查契约、文档一致性、测试、dataClassification 和审批要求",
      "连续两个 shard 输出互相矛盾且无法裁决时必须停止并请求 human owner 决策"
    ]
  },
  "continuationRules": {
    "allowStopWhen": [
      "当前 WorkItem 已完成且通过约定验证",
      "触发 ApprovalGate 或需要人工 owner 决策",
      "触发 dataClassification 限制、权限限制或未授权 writeSet 扩大",
      "继续推进会显著降低质量，例如无法验证、上下文混乱、依赖缺失或风险无法判断",
      "到达 checkpoint 且已交付 ChangePacket 或 ExecutionReportCard"
    ],
    "mustContinueWhen": [
      "只是完成子步骤但同范围还有明确下一步",
      "测试或检查失败且存在合理修复路径",
      "文档、代码、执行计划或质量门禁之间出现明显不一致",
      "还没有说明当前结果、剩余风险和下一步"
    ],
    "checkpointDeliverables": [
      "ChangePacket",
      "ExecutionReportCard",
      "验证命令和结果",
      "剩余风险",
      "下一步建议"
    ]
  },
  "harnessPrinciples": [
    "仓库知识是 system of record",
    "AGENTS.md 是入口地图，不是巨型手册",
    "复杂计划是一等资产",
    "约束能机械检查就不只写成口头规则",
    "agent 可读性和人类可审计性同等重要",
    "持续推进服从质量、审批、审计、预算和数据分级"
  ],
